# Copied to .env by ./run.sh. Every value has a default; change what you need.

# ollama = real local models.  fixture = deterministic stand-ins, no model needed (tests, CI).
PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434

# Smallest useful pair (~400 MB + ~46 MB). Try GEN_MODEL=qwen2.5:1.5b or llama3.2:3b for better answers.
GEN_MODEL=qwen2.5:0.5b
EMBED_MODEL=all-minilm

PORT=8130
TOP_K=4
CANDIDATES=20
# Seconds the model may take before the pipeline refuses instead of hanging.
BUDGET_S=60
# auto = rewrite only when there is chat history. always | off
REWRITE=auto
# Leave unset to use the value from `./run.sh calibrate` (stored in .data/calibration.json).
# SCORE_FLOOR=0.25
# Share of a claim's words that must appear in its cited source.
SUPPORT_FLOOR=0.5
